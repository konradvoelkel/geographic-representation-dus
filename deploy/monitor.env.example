# Vorlage für ~/.config/georep/monitor.env (Nutzereinheit) oder /etc/georep/monitor.env (VPS).
# Kopieren, Pfade eintragen, Rechte 0600. Keine Zugangsdaten hier: rclone bekommt seine
# Konfiguration über LoadCredential (deploy/systemd/georep-monitor.service.d/r2.conf.example).
#
# systemd liest diese Datei als KEY=WERT, ohne Shell: keine Anführungszeichen, keine Expansion
# von $HOME und keine Kommentare hinter dem Wert.

# --- Was das Skript braucht (nur hier, nie im Code) -------------------------------------------
# Das Präfix MONITOR_ ist Absicht: GEOREP_* liest pydantic-settings als Einstellung, und
# GEOREP_PROFILE=settings.2025.toml würde jeden georep-Aufruf mit einem Validierungsfehler
# beenden (profile ist ein Ordnername).
MONITOR_REPO=/home/konrad/files/work/georep
MONITOR_SETTINGS=settings.2025.toml
MONITOR_PROFILE=2025
MONITOR_PUBLISH_DIR=/media/konrad/xtraspace/georep/monitor
MONITOR_UV=/home/konrad/.local/bin/uv
# rclone 1.60.1 aus Ubuntu meldet geglückte Uploads als Fehler (bubatzblick DEPLOY.md): 1.75.1 nehmen
MONITOR_RCLONE=/home/konrad/.local/bin/rclone
# Leer lassen, solange es das Bucket nicht gibt; sonst etwa georep:georep
MONITOR_R2_REMOTE=
# Leer lassen, solange der VPS nicht steht; sonst etwa root@vps und /var/www/georep
MONITOR_VPS_HOST=
MONITOR_VPS_WWW=
# Monatliche Schnappschüsse der Downloads, die aufgehoben werden (24 = zwei Jahre)
MONITOR_SNAPSHOT_KEEP=24
# Optionaler Healthcheck (healthchecks.io und Ähnliches); leer = keiner
MONITOR_HEALTHCHECK_URL=
# Nicht leer = Trockenlauf: kein Abruf, kein Upload, keine Übertragung
DRY_RUN=

# --- Was georep selbst liest (Einstellungen über die Umgebung) --------------------------------
GEOREP_DATA_ROOT=/media/konrad/xtraspace/georep/monitor/data
GEOREP_CACHE_ROOT=/media/konrad/xtraspace/georep/monitor/cache
GEOREP_LOG_LEVEL=INFO

# --- Was uv braucht ---------------------------------------------------------------------------
# systemd kennt keinen Login-PATH (Playbook § 3.2): uv und rclone liegen in ~/.local/bin.
PATH=/home/konrad/.local/bin:/usr/local/bin:/usr/bin:/bin
UV_PROJECT_ENVIRONMENT=/media/konrad/xtraspace/venvs/georep
UV_CACHE_DIR=/media/konrad/xtraspace/uv-cache
