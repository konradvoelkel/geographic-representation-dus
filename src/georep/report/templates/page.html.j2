<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }} · {{ model.city.name }}, {{ model.period.title }}</title>
<meta name="description" content="{{ page.lead }}">
<style>
{% include "frame/style.css.j2" +%}
{{ page_css|safe }}</style>
{% if model.preview_rows %}
<noscript><style>table.preview tbody tr { display: table-row !important; } p.more { display: none !important; }</style></noscript>
{% endif %}
</head>
<body>
<header>
<h1>{{ page.title }}</h1>
<p class="lead">{{ page.lead }}</p>
<p class="meta"><a href="index.html">Zur Startseite: Ratsdokumente {{ model.city.genitive }}, {{ model.period.title }}</a>. Gebaut mit georep {{ model.version }}; Quelltext und Daten im <a href="{{ links.repository }}">Repository</a>.</p>
</header>
<main>
{% include page.template %}
{# Vorarbeit V1: die Abschnitte fremder Beiträge, in der Folge aus sections_for, je mit ihren eigenen Daten und dem Anker #<name> (Review K1) #}
{% for section, section_data in sections %}

<section id="{{ section.name }}">
{% with data = section_data %}
{% include section.template %}
{% endwith %}
</section>
{% endfor %}
</main>
{% include "frame/page_footer.html.j2" +%}
<dialog id="docs" aria-labelledby="docs-title"><form method="dialog"><button type="submit">Schließen</button></form><h3 id="docs-title"></h3><p class="note"></p><ol></ol></dialog>
<div id="tooltip" role="tooltip" hidden></div>
<script>
{% include "frame/script.js.j2" +%}
</script>
{# Review N2: je JavaScript-Datei ein eigenes Skript, die der Seite zuerst #}
{% for code in page_scripts %}
<script>
{{ code|safe }}
</script>
{% endfor %}
</body>
</html>
