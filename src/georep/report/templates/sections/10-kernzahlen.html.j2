<section id="kernzahlen">
<h2>Kernzahlen</h2>
<div class="tiles">
<div class="tile"><div class="label">Wahlbezirke</div><div class="value">{{ model.figures.districts|num }}</div><div class="sub">aus {{ model.figures.precincts|num }} Stimmbezirken</div></div>
<div class="tile"><div class="label">Ratsdokumente</div><div class="value">{{ model.figures.documents|num }}</div><div class="sub">{{ model.figures.documents_with_text|num }} mit Text{% if model.figures.documents_without_text %}, {{ model.figures.documents_without_text|num }} ohne{% endif %}</div></div>
<div class="tile"><div class="label">Suchbegriffe</div><div class="value">{{ model.figures.terms|num }}</div><div class="sub">Straßen und Orte, alle Bezirke</div></div>
<div class="tile"><div class="label">Dokumente mit Treffer</div><div class="value">{{ model.figures.documents_hit|num }}</div><div class="sub">{{ (model.figures.documents_hit / model.figures.documents)|pct(1) }} aller Dokumente{% if model.figures.documents_without_text and model.figures.hit_share_of_text %}, {{ model.figures.hit_share_of_text|pct(1) }} der {{ model.figures.documents_with_text|num }} mit Text{% endif %}</div></div>
<div class="tile"><div class="label">Trefferquote, Median</div><div class="value">{{ model.figures.rate_median|num(3) }}</div><div class="sub">Spannweite {{ model.figures.rate_min|num(3) }} bis {{ model.figures.rate_max|num(3) }}</div></div>
{% if model.figures.per_term_max %}{# Punkt 46: die zweite Kennzahl des Methodik-Reviews #}
<div class="tile"><div class="label">Treffer je Begriff, Median</div><div class="value">{{ model.figures.per_term_median|num(2) }}</div><div class="sub">Spannweite {{ model.figures.per_term_min|num(2) }} bis {{ model.figures.per_term_max|num(2) }}</div></div>
{% endif %}
<div class="tile"><div class="label">Wahlbeteiligung, Median</div><div class="value">{{ model.figures.turnout_median|pct(1) }}</div><div class="sub">je Wahlbezirk, Kommunalwahl {{ model.stand.election|date_de }}</div></div>
</div>
</section>
