<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Geografische Repräsentation in {{ model.city.adjective }} Ratsdokumenten, {{ model.period.title }}</title>
<meta name="description" content="Wie sichtbar sind die {{ model.figures.districts }} Kommunalwahlbezirke {{ model.city.genitive }} in den Ratsdokumenten der {{ model.period.title }}, und hängt das mit der Wahlbeteiligung zusammen? Karte, Tabellen, Downloads.">
<style>
:root {
  color-scheme: light dark;
  --bg: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11, 11, 11, 0.10); --accent: #2a78d6;
  --selected: #eb6834;
  --q0: #86b6ef; --q1: #5598e7; --q2: #2a78d6; --q3: #1c5cab; --q4: #0d366b;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --border: rgba(255, 255, 255, 0.10); --accent: #3987e5;
    --selected: #d95926;
    --q0: #184f95; --q1: #256abf; --q2: #3987e5; --q3: #6da7ec; --q4: #b7d3f6;
  }
}
* { box-sizing: border-box; }
html { background: var(--bg); color: var(--ink); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
body { margin: 0 auto; padding: 1.5rem 1rem 3rem; max-width: 72em; }
h1 { font-size: 1.75rem; line-height: 1.25; margin: 0 0 .5rem; }
h2 { font-size: 1.3rem; margin: 2.5rem 0 .75rem; }
h3 { font-size: 1.05rem; margin: 1.5rem 0 .5rem; }
p, li { max-width: 48em; }
a { color: var(--accent); }
.meta, .note, .footnote, footer { color: var(--ink-2); font-size: .9rem; }
p[lang="en"] { border-left: 3px solid var(--grid); padding-left: .75rem; color: var(--ink-2); }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5em, 1fr)); gap: .75rem; margin: 1rem 0; }
.tile { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: .75rem .9rem; }
.tile .label { color: var(--ink-2); font-size: .85rem; }
.tile .value { font-size: 1.6rem; font-weight: 600; line-height: 1.2; }
.tile .sub { color: var(--muted); font-size: .8rem; }
.controls { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; margin: .5rem 0 1rem; }
fieldset { border: 0; padding: 0; margin: 0; display: inline-flex; flex-wrap: wrap; gap: 1rem; }
legend { color: var(--ink-2); font-size: .85rem; padding: 0; }
.map-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 14em; gap: 1rem; align-items: start; }
@media (max-width: 40em) { .map-wrap { grid-template-columns: 1fr; } }
svg.map { width: 100%; height: auto; background: var(--surface); border-radius: 6px; }
svg.scatter { width: 100%; max-width: 40em; height: auto; background: var(--surface); border-radius: 6px; }
.district { stroke: var(--surface); stroke-width: 1.5px; vector-effect: non-scaling-stroke; cursor: pointer; transition: filter .1s; }
.district:hover, .district:focus { filter: brightness(1.15); outline: none; }
.district.selected { stroke: var(--selected); stroke-width: 2.5px; }
.q0 { fill: var(--q0); } .q1 { fill: var(--q1); } .q2 { fill: var(--q2); } .q3 { fill: var(--q3); } .q4 { fill: var(--q4); }
/* Punkt 46: die divergierende Rampe für die Varianten „Abweichung vom Mittel" und „Verhältnis zum
   Mittel". Orange heißt unter dem Mittel, blau darüber, die Mitte ist ein neutrales Grau. Beide
   Enden entstehen mit color-mix aus Variablen, die je Modus definiert sind, also folgt die Rampe
   Hell und Dunkel ohne zweiten @media-Block -- dasselbe Verfahren wie die Tönung darunter.
   Eine Rampe für Flächen und für Tabellenzellen: die Zellen tragen Zahlen, darum sind die Stufen
   gemischt und nicht voll gesättigt.
   Nachgerechnet am 2026-10-13 (WCAG-Kontrast der normalen Schriftfarbe auf jeder Stufe):
     hell   #ef8960 7,89 | #f6cab7 13,17 | #d0d0cd 12,73 | #b5cfee 12,30 | #5895de 6,34
     dunkel #af4b23 5,45 | #5b2f1d 11,23 | #444341  9,88 | #253f5e 10,76 | #326fb8 5,12
   Minimum 6,34 hell und 5,12 dunkel, also überall über 4,5. Die Mitte ist mit 38 % Grau
   bewusst sichtbar und nicht fast --surface: auf der Karte liegt der Flächenrand in --surface,
   und eine Fläche in Hintergrundfarbe wäre dort verschwunden. */
:root {
  --d0: color-mix(in srgb, var(--selected) 78%, var(--surface));
  --d1: color-mix(in srgb, var(--selected) 34%, var(--surface));
  --d2: color-mix(in srgb, var(--muted) 38%, var(--surface));
  --d3: color-mix(in srgb, var(--q2) 34%, var(--surface));
  --d4: color-mix(in srgb, var(--q2) 78%, var(--surface));
}
.d0 { fill: var(--d0); } .d1 { fill: var(--d1); } .d2 { fill: var(--d2); } .d3 { fill: var(--d3); } .d4 { fill: var(--d4); }
/* Dieselbe Klasse, zwei Flächen: auf einer SVG-Fläche liegt kein Text, in einer Tabellenzelle
   steht eine Zahl. Darum ist die sequenzielle Rampe als Zellenhintergrund nicht --q0 bis --q4,
   sondern eine Tönung aus einer einzigen Farbe (fünf Stufen von --q2 in --surface, Option 04,
   Punkt 46). So trägt ein Umschalter eine Skala und nicht zwei.
   Nachgerechnet am 2026-10-12 (WCAG-Kontrast der normalen Schriftfarbe auf jeder Stufe):
     hell   --ink  #0b0b0b: 16,95 / 14,09 / 11,29 / 8,65 / 6,34  (Minimum 6,34)
     dunkel --ink  #ffffff: 15,50 / 12,69 /  9,67 / 7,16 / 5,12  (Minimum 5,12)
   Beide Reihen sind monoton und überall über 4,5. Die volle Rampe hätte das nicht geschafft:
   --q2 hell trägt nur 4,46 mit dunkler und 4,30 mit heller Schrift, also in keiner Richtung AA. */
:root {
  --p0: color-mix(in srgb, var(--q2) 10%, var(--surface));
  --p1: color-mix(in srgb, var(--q2) 24%, var(--surface));
  --p2: color-mix(in srgb, var(--q2) 40%, var(--surface));
  --p3: color-mix(in srgb, var(--q2) 58%, var(--surface));
  --p4: color-mix(in srgb, var(--q2) 78%, var(--surface));
}
td.q0 { background: var(--p0); } td.q1 { background: var(--p1); } td.q2 { background: var(--p2); }
td.q3 { background: var(--p3); } td.q4 { background: var(--p4); }
.swatch.d0 { background: var(--d0); } .swatch.d1 { background: var(--d1); } .swatch.d2 { background: var(--d2); }
.swatch.d3 { background: var(--d3); } .swatch.d4 { background: var(--d4); }
td.d0 { background: var(--d0); } td.d1 { background: var(--d1); } td.d2 { background: var(--d2); }
td.d3 { background: var(--d3); } td.d4 { background: var(--d4); }
.map-labels text { font-size: 11px; fill: var(--ink); text-anchor: middle; dominant-baseline: middle; pointer-events: none; paint-order: stroke; stroke: var(--surface); stroke-width: 3px; stroke-linejoin: round; }
.pois { display: none; } .pois.on { display: initial; } .pois circle { fill: var(--ink-2); opacity: .7; pointer-events: none; }
.legend { font-size: .85rem; }
.legend ul, .line-legend ul { list-style: none; padding: 0; margin: 0; }
.legend li, .line-legend li { display: flex; align-items: center; gap: .5rem; margin: .25rem 0; }
.swatch { display: inline-block; width: 1.1em; height: 1.1em; border-radius: 3px; flex: none; }
.swatch.q0 { background: var(--q0); } .swatch.q1 { background: var(--q1); } .swatch.q2 { background: var(--q2); } .swatch.q3 { background: var(--q3); } .swatch.q4 { background: var(--q4); }
.line-legend { display: flex; gap: 1.5rem; font-size: .85rem; margin: .5rem 0; }
.key { display: inline-block; width: 2em; border-top: 2px solid var(--ink-2); }
.key.dashed { border-top-style: dashed; }
.grid line { stroke: var(--grid); stroke-width: 1; }
.axis line { stroke: var(--axis); stroke-width: 1; }
.ticks text, .axis-label { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
.fit { stroke: var(--ink-2); stroke-width: 2; fill: none; stroke-linecap: round; }
.fit-without { stroke-dasharray: 6 4; }
.hit { fill: transparent; cursor: pointer; }
.dot { fill: var(--accent); stroke: var(--surface); stroke-width: 2; pointer-events: none; }
.dot-label { font-size: 10px; fill: var(--muted); pointer-events: none; }
.point:focus { outline: none; }
.point:hover .dot, .point:focus .dot, .point.selected .dot { fill: var(--selected); }
table { border-collapse: collapse; width: 100%; font-size: .9rem; background: var(--surface); }
th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--ink-2); font-weight: 600; }
th[data-sort] { cursor: pointer; user-select: none; }
th[data-sort]::after { content: " ↕"; color: var(--muted); }
th[aria-sort="ascending"]::after { content: " ↑"; color: var(--ink); }
th[aria-sort="descending"]::after { content: " ↓"; color: var(--ink); }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
tr.selected td { background: color-mix(in srgb, var(--selected) 18%, var(--surface)); }
.scroll { overflow-x: auto; }
.small { font-size: .85rem; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8em; overflow-wrap: anywhere; }
details { margin: .4rem 0; }
summary { cursor: pointer; }
ol.terms { columns: 3; column-gap: 1.5rem; padding-left: 1.4em; font-size: .85rem; max-width: none; }
@media (max-width: 40em) { ol.terms { columns: 1; } }
ol.terms li { break-inside: avoid; }
.count { color: var(--muted); }
button.term { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
button.term:hover, button.term:focus { text-decoration: underline; }
.pois.on circle { pointer-events: all; cursor: pointer; }
.pois circle:hover { fill: var(--selected); opacity: 1; }
dialog#docs { max-width: 46em; width: calc(100% - 2rem); border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--ink); padding: 1rem 1.25rem; }
dialog#docs::backdrop { background: rgba(0, 0, 0, .4); }
dialog#docs h3 { margin: 0 2.5em .25rem 0; }
dialog#docs form { position: absolute; right: .75rem; top: .75rem; }
dialog#docs ol { padding-left: 1.4em; max-width: none; font-size: .9rem; }
dialog#docs li { margin: .3rem 0; }
dialog#docs .when { color: var(--muted); font-variant-numeric: tabular-nums; margin-right: .4em; }
dialog#docs .ref { color: var(--ink-2); font-size: .85em; }
#tooltip { position: absolute; z-index: 10; background: var(--surface); color: var(--ink); border: 1px solid var(--border); border-radius: 6px; padding: .5rem .7rem; font-size: .85rem; max-width: 20em; box-shadow: 0 2px 8px rgba(0, 0, 0, .15); pointer-events: none; }
#tooltip strong { display: block; font-size: 1rem; }
#tooltip .terms { color: var(--ink-2); }
footer { margin-top: 3rem; border-top: 1px solid var(--grid); padding-top: 1rem; }
{{ section_css|safe }}</style>
</head>
<body>
<header>
<h1>Geografische Repräsentation in {{ model.city.adjective }} Ratsdokumenten</h1>
<p class="lead">Wie sichtbar sind die {{ model.figures.districts }} Kommunalwahlbezirke {{ model.city.genitive }} in den Dokumenten des {{ model.city.council }}s{% if model.regression %}, und hängt das mit der Wahlbeteiligung zusammen?{% else %} seit der Kommunalwahl am {{ model.stand.election|date_de }}?{% endif %} Für jeden Wahlbezirk gibt es ein Wörterbuch aus Straßennamen und Orten; die {{ model.figures.documents|num }} Ratsdokumente der {{ model.period.title }} werden danach durchsucht; die Zahl der Dokumente mit mindestens einem Treffer, geteilt durch die Wahlberechtigten, ist die Trefferquote des Bezirks.</p>
<p class="meta">Datenstand: {{ model.period.title }}, Kommunalwahl {{ model.stand.election|date_de }}{% if model.period.converted %} (ihr Ergebnis über Flächenanteile auf die heutigen Wahlbezirke umgerechnet, siehe Methode){% endif %}; Dokumente {{ model.stand.period_start|date_de }} bis {% if model.stand.period_end %}{{ model.stand.period_end|date_de }}{% else %}heute (laufende Wahlperiode){% endif %}{% if model.stand.papers_fetched %}; Metadaten abgerufen am {{ model.stand.papers_fetched|date_de }}{% if model.stand.pdfs_fetched %}, PDFs am {{ model.stand.pdfs_fetched|date_de }}{% endif %}{% endif %}{% if model.stand.newest_document %}; neuestes Dokument vom {{ model.stand.newest_document|date_de }}{% endif %}{% if model.figures.documents_without_text == 1 %}; ein Dokument ohne Text{% elif model.figures.documents_without_text %}; {{ model.figures.documents_without_text|num }} Dokumente ohne Text{% endif %}; Straßen und Orte {% if model.stand.streets_fetched and model.stand.pois_fetched %}abgerufen am {{ model.stand.streets_fetched|date_de }} (OpenStreetMap) und {{ model.stand.pois_fetched|date_de }} (Wikidata, Wikipedia){% else %}{{ model.data_note or 'aus dem mitgelieferten Datensatz' }}{% endif %}. Gebaut mit georep {{ model.version }}; Quelltext und Daten im <a href="{{ links.repository }}">Repository</a>.</p>
{# georep publish ersetzt die Marke durch die Zeile mit den Nachbarstädten, sobald deren Seiten wirklich daneben liegen #}
<!--georep:weitere-staedte-->
<p lang="en">This page summarises how visible each of the {{ model.figures.districts }} municipal election districts of {{ model.city.name }} is in the city council's documents of the {{ model.period.years }} term: every district has a dictionary of street and place names, {{ model.figures.documents|num }} council documents were searched, and the number of documents mentioning a district is divided by its eligible voters.{% if model.regression %} That rate is compared with the district's turnout in the {{ model.period.election.year }} local election; across all districts the linear regression gives p = {{ model.regression.all.p|num(3) }}{% if model.regression.all.p >= 0.05 %}, so no relationship is established{% endif %}.{% else %} There is no turnout figure for a term still under way, so this page shows no regression; it counts documents per month instead.{% endif %}{% if model.sensitivity %}{# Option 06 #} Under {{ model.sensitivity.significant_all }} of {{ model.sensitivity.rows|length }} weightings of the same documents, the unweighted count included, the relationship across all districts reaches the {{ model.sensitivity.level|pct(0) }} level.{% endif %} The results are available below as Parquet, CSV and GeoJSON, with a documented column schema.</p>
</header>
<main>
{% for section in sections %}
{% include section %}
{% endfor %}
</main>
<footer>
<p>Ergebnisse: <a href="{{ links.cc0 }}">CC0 1.0</a>; Quelltext: <a href="{{ links.gpl }}">GPL-3.0-or-later</a>. Straßennamen abgeleitet aus OpenStreetMap, © <a href="{{ links.osm }}">OpenStreetMap-Mitwirkende</a>, <a href="{{ links.odbl }}">ODbL</a>. Orte aus <a href="{{ links.wikidata }}">Wikidata</a> (CC0) und Artikeltiteln der deutschsprachigen <a href="{{ links.wikipedia }}">Wikipedia</a>.{% if model.derived %} Kontrollvariablen abgeleitet aus: {{ model.derived.attribution }} (<a href="{{ model.derived.license_url }}">{{ model.derived.license }}</a>, Stand {{ model.derived.stand|date_de }}).{% endif %}</p>
<p>Quellen der Stadt {{ model.city.name }}:
{% for source in model.sources %}
{{ source.name }} (<a href="{{ source.url }}">{{ source.publisher }}</a>{% if source.license and source.license_url %}, <a href="{{ source.license_url }}">{{ source.license }}</a>{% elif source.license %}, {{ source.license }}{% else %}, Lizenz laut Anbieter nicht angegeben{% endif %}{% if source.checked %}, geprüft am {{ source.checked|date_de }}{% endif %}){% if not loop.last %}; {% else %}.{% endif %}
{% endfor %}
&nbsp;Ratsdokumente aus dem Ratsinformationssystem der {{ model.city.publisher }}; die Seite nennt nur ihre Kennungen.</p>
<p>Erzeugt am {{ model.generated_at|datetime_de }} mit georep {{ model.version }}{% if model.commit %}, Commit {{ model.commit }}{% endif %}.</p>
</footer>
<dialog id="docs" aria-labelledby="docs-title"><form method="dialog"><button type="submit">Schließen</button></form><h3 id="docs-title"></h3><p class="note"></p><ol></ol></dialog>
<div id="tooltip" role="tooltip" hidden></div>
<script>
(function () {
  "use strict";
  var tooltip = document.getElementById("tooltip");
  var rows = {};
  document.querySelectorAll("#districts tbody tr").forEach(function (tr) { rows[tr.dataset.id] = tr; });

  function line(parent, text, cls) {
    var el = document.createElement(cls === "strong" ? "strong" : "div");
    if (cls && cls !== "strong") el.className = cls;
    el.textContent = text;
    parent.appendChild(el);
  }
  function showTooltip(el, x, y) {
    var d = el.dataset;
    tooltip.textContent = "";
    if (d.district !== undefined) {
      line(tooltip, d.name, "strong");
      var row = rows[d.district];
      line(tooltip, "Wahlbezirk " + d.district + (row ? " " + row.cells[1].textContent : ""));
    } else {
      line(tooltip, d.id + " " + d.name, "strong");
      line(tooltip, d.hits + " Dokumente, " + d.eligible + " Wahlberechtigte");
      line(tooltip, "Trefferquote " + d.rate + ", Wahlbeteiligung " + d.turnout);
      if (d.own) line(tooltip, "eigene Bezirksvertretung: " + d.own);  /* Option 05 */
      if (d.terms) line(tooltip, d.terms, "terms");
    }
    tooltip.hidden = false;
    var w = tooltip.offsetWidth, h = tooltip.offsetHeight;
    var left = x + 14, top = y + 14;
    if (left + w > window.scrollX + document.documentElement.clientWidth - 8) left = x - w - 14;
    if (top + h > window.scrollY + document.documentElement.clientHeight - 8) top = y - h - 14;
    tooltip.style.left = Math.max(window.scrollX + 4, left) + "px";
    tooltip.style.top = Math.max(window.scrollY + 4, top) + "px";
  }
  function hideTooltip() { tooltip.hidden = true; }
  /* Markiert einen Bezirk (Zahl oder Text), mehrere (Array) oder keinen (null) in Karte, Tabelle und
     Streudiagramm; scroll (Standard: wahr) holt die erste Tabellenzeile ins Bild. */
  function select(ids, scroll) {
    document.querySelectorAll(".selected").forEach(function (el) { el.classList.remove("selected"); });
    if (ids === null || ids === undefined) return;
    var list = Array.isArray(ids) ? ids : [ids];
    list.forEach(function (id) {
      document.querySelectorAll('[data-id="' + id + '"]').forEach(function (el) {
        el.classList.add("selected");
        if (el.classList.contains("district")) el.parentNode.appendChild(el);
      });
    });
    if (scroll !== false && list.length && rows[list[0]]) rows[list[0]].scrollIntoView({ block: "nearest" });
  }
  var marks = document.querySelectorAll(".district, .point");
  marks.forEach(function (el) {
    el.addEventListener("pointermove", function (e) { showTooltip(el, e.pageX, e.pageY); });
    el.addEventListener("pointerleave", hideTooltip);
    el.addEventListener("focus", function () {
      var r = el.getBoundingClientRect();
      showTooltip(el, r.left + window.scrollX + r.width / 2, r.top + window.scrollY + r.height / 2);
    });
    el.addEventListener("blur", hideTooltip);
    el.addEventListener("click", function () {
      select(el.classList.contains("selected") ? null : el.dataset.id);
    });
    el.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); el.click(); }
    });
  });
  Object.keys(rows).forEach(function (id) {
    rows[id].addEventListener("click", function () { select(rows[id].classList.contains("selected") ? null : id); });
  });

  /* Umschalter einer Kennzahl (Punkt 46): ein fieldset.switcher mit einem Radio je Variante.
     Jedes Element, das die Variante kennt, traegt sie als data-class-<value> (Stufe der
     Farbskala), data-text-<value> (angezeigte Zahl) oder data-value-<value> (Sortierwert); die
     Legenden heissen #legend-<value>, und die Skala steht als data-scale am Radio (Standard q,
     sequenziell; d ist die divergierende um das Mittel). Eine neue Variante ist damit ein Radio,
     ein Attribut je Element und eine Legende -- kein neues JavaScript.
     Gesucht wird im ganzen Dokument, nicht im Abschnitt: der Umschalter der Karte faerbt auch die
     Spalte der Tabelle je Wahlbezirk, die in einem anderen <section> steht. Getrennt halten die
     Gruppen sich dadurch, dass kein value zweimal vorkommt (ein Test haelt das fest). */
  var STEP = /^[qd][0-9]$/;  /* die beiden Farbrampen; nur diese Klasse tauscht ein Umschalter */
  function setStep(el, token) {
    Array.prototype.slice.call(el.classList).forEach(function (name) {
      if (STEP.test(name)) el.classList.remove(name);
    });
    el.classList.add(token);
  }
  /* Die Standardvariante braucht keine Attribute: sie ist der Zustand, in dem die Seite
     ausgeliefert wird. Beim Aufbau merkt sich der Umschalter je Element Klasse, Text und
     Sortierwert, und wer auf eine Variante schaltet, die ein Element nicht kennt, bekommt genau
     diesen Zustand zurueck. Das spart die Haelfte der Attribute und macht die Vorlagen kuerzer. */
  function membersOf(values) {
    var parts = [];
    values.forEach(function (value) {
      parts.push("[data-class-" + value + "]", "[data-text-" + value + "]", "[data-value-" + value + "]");
    });
    var found = [];
    document.querySelectorAll(parts.join(",")).forEach(function (el) {
      found.push({
        el: el,
        klass: el.getAttribute("class"),
        text: el.textContent,
        value: el.getAttribute("data-value"),
      });
    });
    return found;
  }
  function showVariant(value, scale, values, members) {
    members.forEach(function (member) {
      var el = member.el;
      var klass = el.getAttribute("data-class-" + value);
      var text = el.getAttribute("data-text-" + value);
      var sort = el.getAttribute("data-value-" + value);
      if (klass !== null) setStep(el, scale + klass);
      else if (member.klass !== null) el.setAttribute("class", member.klass);
      if (text !== null) el.textContent = text;
      else el.textContent = member.text;
      if (sort !== null) el.setAttribute("data-value", sort);
      else if (member.value !== null) el.setAttribute("data-value", member.value);
    });
    values.forEach(function (other) {
      var legend = document.getElementById("legend-" + other);
      if (legend) legend.hidden = other !== value;
    });
  }
  document.querySelectorAll("fieldset.switcher").forEach(function (fieldset) {
    var radios = Array.prototype.slice.call(fieldset.querySelectorAll('input[type="radio"]'));
    var values = radios.map(function (radio) { return radio.value; });
    var members = membersOf(values);
    radios.forEach(function (radio) {
      radio.addEventListener("change", function () {
        showVariant(radio.value, radio.dataset.scale || "q", values, members);
      });
    });
  });
  var pois = document.getElementById("show-pois");
  if (pois) pois.addEventListener("change", function () {
    document.querySelectorAll(".pois").forEach(function (g) { g.classList.toggle("on", pois.checked); });
  });
  document.querySelectorAll(".pois circle").forEach(function (el) {
    el.addEventListener("pointermove", function (e) { showTooltip(el, e.pageX, e.pageY); });
    el.addEventListener("pointerleave", hideTooltip);
  });

  var dialog = document.getElementById("docs");
  var docsPromise = null;
  function loadDocs() {
    if (!docsPromise) {
      docsPromise = fetch("data/dokumente.json").then(function (r) {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    }
    return docsPromise;
  }
  function germanDate(iso) {
    var p = iso.split("-");
    return p.length === 3 ? p[2] + "." + p[1] + "." + p[0] : iso;
  }
  /* Zeigt die Dokumente eines oder mehrerer Begriffe (Array) im Dialog; die Indizes werden vereinigt
     und aufsteigend sortiert, die Liste ist neueste zuerst. title ist die Ueberschrift des Dialogs. */
  function showDocuments(terms, title) {
    var list = Array.isArray(terms) ? terms : [terms];
    var heading = dialog.querySelector("h3"), note = dialog.querySelector("p"), ol = dialog.querySelector("ol");
    heading.textContent = title !== undefined ? title : list.join(", ");
    note.textContent = "Lade data/dokumente.json …";
    ol.textContent = "";
    if (typeof dialog.showModal === "function") dialog.showModal(); else dialog.setAttribute("open", "");
    loadDocs().then(function (data) {
      var seen = {}, ids = [];
      list.forEach(function (term) {
        (data.terms[term] || []).forEach(function (i) { if (!seen[i]) { seen[i] = true; ids.push(i); } });
      });
      ids.sort(function (a, b) { return a - b; });
      note.textContent = ids.length + " Dokumente mit " + (list.length > 1 ? "diesen Begriffen" : "diesem Begriff") + ", neueste zuerst.";
      ids.forEach(function (i) {
        var doc = data.documents[i];
        var li = document.createElement("li");
        var when = document.createElement("span");
        when.className = "when";
        when.textContent = germanDate(doc[1]);
        var a = document.createElement("a");
        a.href = doc[0].indexOf("http") === 0 ? doc[0] : data.base + doc[0];
        a.textContent = doc[3];
        var ref = document.createElement("div");
        ref.className = "ref";
        /* Option 04: hinter Drucksache und Art steht der Urheber, wenn dokumente.json ihn traegt. */
        ref.textContent = doc[2] + (doc[4] ? ", " + doc[4] : "") + (doc[5] ? " \u2014 " + doc[5] : "");
        li.appendChild(when); li.appendChild(a); li.appendChild(ref);
        ol.appendChild(li);
      });
    }).catch(function () {
      note.textContent = "Die Dokumentliste (data/dokumente.json) ließ sich nicht nachladen. Aus dem Dateisystem geöffnet erlaubt der Browser das nicht; über einen Webserver oder unter der veröffentlichten Adresse funktioniert es.";
    });
  }
  document.querySelectorAll("button.term").forEach(function (button) {
    button.addEventListener("click", function () { showDocuments([button.textContent], button.textContent); });
  });

  document.querySelectorAll("th[data-sort]").forEach(function (th) {
    th.addEventListener("click", function () {
      var table = th.closest("table"), tbody = table.tBodies[0];
      var index = Array.prototype.indexOf.call(th.parentNode.children, th);
      var ascending = th.getAttribute("aria-sort") !== "ascending";
      var numeric = th.dataset.sort === "num";
      var list = Array.prototype.slice.call(tbody.rows);
      list.sort(function (a, b) {
        var ca = a.cells[index], cb = b.cells[index];
        if (numeric) return (parseFloat(ca.dataset.value) - parseFloat(cb.dataset.value)) * (ascending ? 1 : -1);
        return ca.textContent.localeCompare(cb.textContent, "de") * (ascending ? 1 : -1);
      });
      list.forEach(function (tr) { tbody.appendChild(tr); });
      table.querySelectorAll("th[data-sort]").forEach(function (other) { other.removeAttribute("aria-sort"); });
      th.setAttribute("aria-sort", ascending ? "ascending" : "descending");
    });
  });

  /* Schnittstelle fuer die Skripte der Abschnitte (templates/sections/NN-name.js). */
  window.georep = { select: select, showDocuments: showDocuments, rows: rows };
})();
</script>
{% if section_js %}
<script>
{{ section_js|safe }}
</script>
{% endif %}
</body>
</html>
